  let currentWeek = "Week 7";

  function renderButtons() {
    const controls = document.getElementById("weekControls");
    controls.innerHTML = "";
    Object.keys(scheduleData).forEach(week => {
      const btn = document.createElement("button");
      btn.className = `week-btn ${week === currentWeek ? 'active' : ''}`;
      btn.textContent = week;
      btn.onclick = () => {
        currentWeek = week;
        renderButtons();
        renderTable();
      };
      controls.appendChild(btn);
    });
  }

  function renderTable() {
    const tbody = document.getElementById("timetableBody");
    tbody.innerHTML = "";
    const days = scheduleData[currentWeek];

    days.forEach(dayInfo => {
      const tr = document.createElement("tr");
      const dayTd = document.createElement("td");
      dayTd.className = "day-col";
      dayTd.textContent = dayInfo.day;
      tr.appendChild(dayTd);

      if (dayInfo.holiday) {
        const holidayTd = document.createElement("td");
        holidayTd.colSpan = 7;
        holidayTd.className = "slot-holiday";
        holidayTd.textContent = `🌴 ${dayInfo.holiday}`;
        tr.appendChild(holidayTd);
      } else {
        dayInfo.slots.forEach(slot => {
          const td = document.createElement("td");
