<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Customized Timetable</title>
  <style>
    :root {
      --primary: #1e3a8a;
      --secondary: #3b82f6;
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text: #1e293b;
      --text-muted: #64748b;
      --holiday-bg: #fee2e2;
      --holiday-text: #991b1b;
      --class-bg: #eff6ff;
      --class-border: #bfdbfe;
      --free-bg: #f1f5f9;
      --free-text: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      padding: 24px 16px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    header {
      text-align: center;
      margin-bottom: 24px;
    }

    h1 {
      font-size: 1.8rem;
      color: var(--primary);
      margin-bottom: 8px;
    }

    .subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-bottom: 24px;
    }

    .week-btn {
      padding: 8px 16px;
      border: 1px solid var(--secondary);
      background: #ffffff;
      color: var(--secondary);
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .week-btn:hover {
      background: var(--class-bg);
    }

    .week-btn.active {
      background: var(--secondary);
      color: #ffffff;
    }

    .card {
      background: var(--card-bg);
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      overflow-x: auto;
      padding: 16px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 800px;
    }

    th, td {
      border: 1px solid #e2e8f0;
      padding: 12px;
      text-align: center;
      vertical-align: middle;
      font-size: 0.9rem;
    }

    th {
      background-color: #f1f5f9;
      color: var(--text);
      font-weight: 700;
      white-space: nowrap;
    }

    .day-col {
      font-weight: 600;
      background-color: #f8fafc;
      width: 110px;
    }

    .slot-class {
      background-color: var(--class-bg);
      border: 1.5px solid var(--class-border);
      border-radius: 6px;
      padding: 8px;
      text-align: left;
    }

    .slot-class .subject {
      font-weight: 700;
      color: var(--primary);
      font-size: 0.95rem;
    }

    .slot-class .room {
      display: inline-block;
      background: #dbeafe;
      color: #1e40af;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      margin: 4px 0;
    }

    .slot-class .faculty {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .slot-holiday {
      background-color: var(--holiday-bg);
      color: var(--holiday-text);
      font-weight: 700;
      border-radius: 6px;
      padding: 12px;
    }

    .slot-free {
      color: var(--free-text);
      font-style: italic;
      font-size: 0.85rem;
    }
  </style>
</head>
<body>

